en\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Or \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a5ddb355e1752ccb05d552c\",\"type\":\"link\",\"fields\":{\"url\":\"https://www.etoro.com/trading/demo-account/\",\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"practice first with a free $100K\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\" virtual portfolio. No deposit required.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"media\":{\"mediaKind\":\"image\",\"image\":71,\"imageUrl\":null,\"imageAlt\":\"Crypto for Beginners Course\",\"mobileImage\":70,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null}},\"complianceTags\":[1]},{\"id\":\"6a4cf96408c5dec8cc2e4558\",\"type\":\"faq\",\"emitStructuredData\":null,\"background\":\"soft-black\",\"blockName\":null,\"tabs\":[{\"id\":\"6a4cf97208c5dec8cc2e4559\",\"questions\":[{\"id\":\"6a4cf97908c5dec8cc2e455a\",\"question\":\"Do I own the crypto I buy on eToro?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"When you open a non-leveraged buy on eToro, you own the underlying cryptoasset. You can hold it, sell it, or transfer eligible assets to your eToro Wallet. Ownership terms vary by product and jurisdiction.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf98408c5dec8cc2e455b\",\"question\":\"Which cryptoassets can I trade?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"More than 150, including Bitcoin, Ethereum, Solana, XRP and Cardano. The exact list varies by region because of local regulation. The current, up-to-date list lives on the crypto markets page.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf98f08c5dec8cc2e455c\",\"question\":\"Can I use CopyTrader for crypto?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Where it’s available, CopyTrader lets you mirror the crypto trades of experienced eToro investors in real time. You can review their full track record, risk score and current portfolio before copying. The minimum copy amount is $200. Past performance is not indicative of future results, and copying involves risk.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf99808c5dec8cc2e455d\",\"question\":\"Is there a demo account?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. Every eToro account comes with a $100,000 virtual portfolio that uses live market data. You can use it to test investing styles, try out CopyTrader, or get familiar with the platform before trading with real funds.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Basics\",\"complianceTags\":[]},{\"id\":\"6a4cf9a408c5dec8cc2e455e\",\"questions\":[{\"id\":\"6a4cf9a808c5dec8cc2e455f\",\"question\":\"What does crypto trading cost on eToro?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A flat 1% on every crypto buy and sell. There are no storage or custody fees. Network fees may apply when you move crypto to or from an external wallet, and eToro Club members qualify for reduced rates as their tier goes up.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf9b008c5dec8cc2e4560\",\"question\":\"Are there any other crypto costs I should know about?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Currency conversion fees apply if your account currency is different from the trading pair, and standard blockchain network fees apply on external transfers. Everything else is covered by the 1% trading fee.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf9b808c5dec8cc2e4561\",\"question\":\"Are there overnight or holding fees?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"No. Non-leveraged crypto positions can be held for as long as you want with no overnight charge and no custody fee. CFD positions (leveraged trades) are a separate product and do carry overnight fees.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Fees\",\"complianceTags\":[]},{\"id\":\"6a4cf9c108c5dec8cc2e4562\",\"questions\":[{\"id\":\"6a4cf9c608c5dec8cc2e4563\",\"question\":\"Can I transfer crypto to an external wallet?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. Supported assets can be moved from eToro to the eToro Wallet, and from there to an external wallet. Not every asset is transferable, transfer and network fees may apply, and availability varies by region.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf9ce08c5dec8cc2e4564\",\"question\":\"How does the Deposit Crypto feature work?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You can deposit supported cryptoassets from an external wallet directly into your eToro account, then convert them to fiat or use them to open positions. Supported assets and availability vary by region.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cf9db08c5dec8cc2e4565\",\"question\":\"How is my crypto stored?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"eToro uses a combination of cold and hot storage with regulated custody providers, two-factor authentication on accounts, and segregated client funds where regulations require it. The exact mix varies by jurisdiction.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Wallet\",\"complianceTags\":[]},{\"id\":\"6a4cfa0108c5dec8cc2e4566\",\"questions\":[{\"id\":\"6a4cfa0708c5dec8cc2e4567\",\"question\":\"What risks should I know about before investing in crypto?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cryptoassets are highly volatile and largely unregulated. Prices can move sharply in short windows, you could lose all of the money you invest, and past performance is not a reliable guide to future results. Do not invest unless you are prepared to lose the full amount.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cfa0f08c5dec8cc2e4568\",\"question\":\"Is my crypto investment protected if something goes wrong?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"In most jurisdictions, cryptoassets are not covered by deposit-insurance or investor-compensation schemes the way bank deposits or some securities are. You should read the regulator’s disclosures for your region before depositing.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a4cfa1908c5dec8cc2e4569\",\"question\":\"Does past performance predict future returns?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"No. The returns shown on investor profiles and Smart Portfolios are historical. They are useful context, but they do not predict future performance and they don’t account for taxes or your specific circumstances.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Risk\",\"complianceTags\":[]}],\"blockType\":\"faq\",\"headline\":\"Straight answers to the questions investors ask first.\",\"complianceTags\":[1]},{\"id\":\"6a4cfa3c08c5dec8cc2e456a\",\"type\":\"closingCta\",\"emphasizeFinalPunctuation\":null,\"showBackgroundImage\":null,\"priorityImageLoading\":null,\"blockName\":null,\"stats\":[{\"id\":\"6a4cfad908c5dec8cc2e456b\",\"label\":\"Regulated globally\"},{\"id\":\"6a4cfaf408c5dec8cc2e456d\",\"label\":\"NASDAQ: ETOR\"},{\"id\":\"6a4cfaf708c5dec8cc2e456e\",\"label\":\"Segregated client funds\"},{\"id\":\"6a4cfafd08c5dec8cc2e456f\",\"label\":\"$$100K demo account\"}],\"blockType\":\"closingCta\",\"eyebrow\":null,\"headline\":\"Trade. Stake. Copy. Know better.\",\"supporting\":null,\"primaryCta\":{\"show\":true,\"label\":\"Start investing\",\"href\":\"https://www.etoro.com/accounts/sign-up\",\"isInternal\":null,\"openInNewTab\":null,\"complianceTags\":[]},\"secondaryCta\":{\"show\":null,\"label\":null,\"href\":null,\"isInternal\":null,\"openInNewTab\":null,\"complianceTags\":[]},\"tertiaryCta\":{\"show\":null,\"label\":null,\"href\":null,\"isInternal\":null,\"openInNewTab\":null,\"complianceTags\":[]},\"disclaimer\":null,\"backgroundImage\":{\"image\":null,\"imageUrl\":null,\"imageAlt\":null,\"mobileImage\":null},\"complianc