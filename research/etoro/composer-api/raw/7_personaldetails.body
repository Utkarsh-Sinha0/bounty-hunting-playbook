\"pricingTable\",\"heading\":\"Three zeros. No catches. \",\"leadRow\":{\"name\":\"Broker commission\",\"note\":null,\"value\":\"$$0\",\"complianceTags\":[]},\"feeScheduleLink\":{\"label\":\"\",\"href\":\"\"},\"disclaimer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Market spread is the natural bid-ask difference, not an eToro fee. Leveraged positions are CFDs with separate fees. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5dee16b02d565e290cff6a\",\"type\":\"featureAccordion\",\"defaultState\":\"revealOnInteraction\",\"clickableCards\":null,\"background\":\"mint-glow\",\"blockName\":null,\"cards\":[{\"id\":\"6a5dee41b02d565e290cff6b\",\"href\":null,\"icon\":{\"asset\":31,\"size\":\"lg\"},\"title\":\"Trade ETFs commission free \",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"iShares (BlackRock), the world's largest ETF provider \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Vanguard — low-cost index ETFs including VOO, VTI\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"SPDR \u0026 Invesco: sector, thematic, and regional ETFs \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Zero commission on all non-leveraged BUY positions \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5dee52b02d565e290cff6c\",\"href\":null,\"icon\":{\"asset\":28,\"size\":\"lg\"},\"title\":\"Diversify with ease \",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"One ETF = exposure to hundreds of companies \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Sector ETFs: tech, healthcare, energy, financials \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Regional ETFs: US, Europe, emerging markets, global \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"From $10 with fractional investing\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5dee65b02d565e290cff6d\",\"href\":null,\"icon\":{\"asset\":32,\"size\":\"lg\"},\"title\":\"Smarter tools, sharper trades \",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Chart with TradingView built in \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Get personalised insights from Tori AI   \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"See the sentiment of millions of investors   \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Automate recurring investments\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5dee8ab02d565e290cff6e\",\"href\":null,\"icon\":{\"asset\":33,\"size\":\"lg\"},\"title\":\"Earn dividends\",\"content\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Non-leveraged BUY means you own the underlying shares \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Dividends credited directly to your eToro account \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"No overnight fees on real ownership positions \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Transparent holdings — see exactly what you own\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null}},\"complianceTags\":[]}],\"blockType\":\"featureAccordion\",\"headline\":\"The ETFs the world trusts. All here. \",\"subtitle\":\"We put everything under one roof for less app-hopping, more investing. \",\"footnote\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Non-leveraged BUY positions on ETFs represent real ownership of the underlying shares. Leveraged and SHORT positions are CFDs. Subject to regional availability.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5f6c5cd3264dd2ff802fbc\",\"type\":\"threeWaysToInvest\",\"background\":null,\"blockName\":null,\"approaches\":[{\"id\":\"6a5f6c60d3264dd2ff802fbe\",\"background\":null,\"label\":\"For those who want automation\",\"heading\":\"Copy an ETF investor.\",\"body\":\"Mirror a verified ETF-focused Pro Investor automatically with CopyTrader™. Their positions are copied in your portfolio, proportionally and in real time. Stop anytime, never paying extra fees.\",\"cta\":{\"label\":\"Find ETF investors\",\"href\":\"https://www.etoro.com/copytrader/\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"footnote\":\"\"},{\"id\":\"6a5f6c60d3264dd2ff802fbf\",\"background\":null,\"label\":\"Curated diversification\",\"heading\":\"ETF Smart Portfolio.\",\"body\":\"Pick a theme — our analysts already did the deep research and optimised allocation. Ideal for long-term investors who want a professional-grade thematic portfolio without the management fees.\",\"cta\":{\"label\":\"Browse Smart Portfolios\",\"href\":\"https://www.etoro.com/investing/portfolios/\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"footnote\":\"\"}],\"blockType\":\"threeWaysToInvest\",\"headline\":\"Three ways in. All of them yours.\",\"subtitle\":\"Pick your own, mirror others, choose a ready-made portfolio - any or all at once.\",\"copyCard\":{\"label\":\"Self-directed investing - Most Popular\",\"heading\":\"Trade on your own.\",\"body\":\"You've got all the best tools right on the same screen: analyst insights, market sentiment, TradingView, ProCharts, breaking news and so much more.\",\"cta\":{\"label\":\"Browse ETFs\",\"href\":\"https://www.etoro.com/discover/markets/etf\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"footnote\":\"\",\"selectedInvestors\":[],\"cardsToShow\":null,\"proInvestorNote\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"mediaSlides\":[{\"id\":\"6a5f6c60d3264dd2ff802fbd\",\"mediaKind\":\"image\",\"image\":144,\"imageUrl\":null,\"imageAlt\":null,\"mobileImage\":143,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null}}],\"background\":null},\"complianceTags\":[]},{\"id\":\"6a5deef8b02d565e290cff6f\",\"type\":\"moreWaysToInvest\",\"autoplay\":null,\"autoplayIntervalSeconds\":null,\"pauseOnInteraction\":null,\"priorityImageLoading\":null,\"background\":\"soft-black\",\"cardBackground\":null,\"blockName\":null,\"slides\":[{\"id\":\"6a5def13b02d565e290cff70\",\"mediaSide\":\"media-right\",\"eyebrow\":\"Fractional shares\",\"headline\":\"Large cap, small capital.\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"No need to buy a full share. Fractional investing from $10 means you can build a premium ETF portfolio on any budget. \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"primaryCta\":{\"label\":\"Learn more\",\"href\":\"https://www.etoro.com/investing/fractional-shares/\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"disclaimer\":null,\"media\":{\"mediaKind\":\"image\",\"image\":98,\"imageUrl\":null,\"imageAlt\":\"Large cap, small capital.\",\"mobileImage\":97,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null},\"lottie\":null,\"lottieUrl\":null},\"complianceTags\":[]},{\"id\":\"6a5df0adb02d565e290cff71\",\"mediaSide\":\"media-right\",\"eyebrow\":\"Dividends\",\"headline\":\"Earned. Credited. Automatically.\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Non-leveraged BUY positions are eligible for dividend earnings, which are credited directly to your eToro account — no action required.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"primaryCta\":{\"label\":\"Learn about dividends\",\"href\":\"https://www.etoro.com/investing/dividend-calendar/\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"disclaimer\":null,\"media\":{\"mediaKind\":\"image\",\"image\":102,\"imageUrl\":null,\"imageAlt\":\"Earned-Credited-Automatically\",\"mobileImage\":null,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null},\"lottie\":null,\"lottieUrl\":null},\"complianceTags\":[]},{\"id\":\"6a5df18fb02d565e290cff72\",\"mediaSide\":\"media-right\",\"eyebrow\":\"AI-powered\",\"headline\":\"AI that knows you.\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Tori, eToro's AI agent, helps you explore ETFs to match your investment goals, risk profile, and interests. Get personalised suggestions based on your portfolio and your preferences.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"primaryCta\":{\"label\":\"Meet Tori\",\"href\":\"https://www.etoro.com/trading/platforms/tori/\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"complianceTags\":[]},\"disclaimer\":null,\"media\":{\"mediaKind\":\"image\",\"image\":27,\"imageUrl\":null,\"imageAlt\":null,\"mobileImage\":163,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null},\"lottie\":null,\"lottieUrl\":null},\"complianceTags\":[]}],\"blockType\":\"moreWaysToInvest\",\"heading\":\"Need more? Here you go.\",\"subheading\":\"Explore everything that makes ETF investing on eToro smarter and easier.\",\"complianceTags\":[]},{\"id\":\"6a5df76bb02d565e290cff73\",\"type\":\"mediaSplit\",\"mediaSide\":\"media-left\",\"bodyListStyle\":\"disc\",\"priorityImageLoading\":null,\"blockName\":null,\"ctas\":[{\"id\":\"6a5df7a6b02d565e290cff74\",\"href\":\"https://www.etoro.com/accounts/sign-up\",\"isInternal\":null,\"openInNewTab\":null,\"variant\":\"primary\",\"label\":\"Get Started\",\"complianceTags\":[]}],\"blockType\":\"mediaSplit\",\"eyebrow\":\"New to ETFs\",\"headline\":\"New to ETFs? You'll like it here.\",\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"start\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Get an entire learning hub of courses, guides and tutorials, all free \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"View clear, user-friendly data and analysis right where you trade \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Easily find ETFs to invest in by sector, region, or theme \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Practice your strategy first with a $100K virtual demo account \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null}},\"disclaimer\":null,\"media\":{\"mediaKind\":\"image\",\"image\":104,\"imageUrl\":null,\"imageAlt\":null,\"mobileImage\":null,\"video\":{\"file\":null,\"poster\":null,\"autoplay\":null,\"loop\":null}},\"complianceTags\":[]},{\"id\":\"6a5df877b02d565e290cff75\",\"type\":\"faq\",\"emitStructuredData\":null,\"background\":\"soft-black\",\"blockName\":null,\"tabs\":[{\"id\":\"6a5e0046b02d565e290cff76\",\"questions\":[{\"id\":\"6a5e004fb02d565e290cff77\",\"question\":\"What is an ETF?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"An Exchange-Traded Fund (ETF) is a basket of securities that tracks an index, sector, commodity, or theme. When you buy an ETF, you get diversified exposure in a single trade. On eToro, non-leveraged BUY positions mean you own the underlying shares — you're a real shareholder, eligible for dividends.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e005fb02d565e290cff78\",\"question\":\"Do I own the ETF shares when I invest on eToro?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. When you open a non-leveraged BUY position on an ETF, you own the underlying shares. You're eligible for dividends and can see your holdings at any time. Leveraged or SHORT positions are executed as CFDs and do not confer ownership.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e0073b02d565e290cff79\",\"question\":\"What's the difference between ETFs and stocks?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A stock represents ownership in a single company. An ETF holds a basket of assets — stocks, bonds, or commodities — giving you instant diversification. One ETF position can give you exposure to hundreds or thousands of companies. For example, buying SPY gives you exposure to all 500 companies in the S\u0026P 500 index.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Basics \",\"complianceTags\":[]},{\"id\":\"6a5e0084b02d565e290cff7a\",\"questions\":[{\"id\":\"6a5e008fb02d565e290cff7b\",\"question\":\"What does zero commission mean?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"On non-leveraged BUY positions for ETFs, eToro charges no commission. You pay the market price and own the shares. Note: FX conversion fees may apply for positions denominated in currencies other than your account currency. See the full fee schedule for details.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e02b8b02d565e290cff7e\",\"question\":\"Are there overnight fees on ETF positions?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Non-leveraged BUY positions (real ownership) do not incur overnight fees. You can hold your ETF shares indefinitely at no ongoing cost. Leveraged or SHORT positions (executed as CFDs) do attract overnight fees, which are displayed before you open any position.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e02d2b02d565e290cff7f\",\"question\":\"What is the minimum investment for ETFs on eToro?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"You can invest in ETFs from as little as $10 using fractional shares. You don't need to buy a full share — you get proportional ownership and proportional dividends. This makes premium ETFs accessible regardless of budget.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Fees\",\"complianceTags\":[]},{\"id\":\"6a5e02e5b02d565e290cff80\",\"questions\":[{\"id\":\"6a5e02ecb02d565e290cff81\",\"question\":\"Can I earn dividends from ETFs on eToro?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. If the ETF distributes dividends, you receive them in proportion to your holding. Dividends are credited directly to your eToro account. The timing and amount depend on the ETF's distribution schedule and your position size at the record date.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e0300b02d565e290cff82\",\"question\":\"What ETF providers are available?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"eToro offers ETFs from leading providers including iShares (BlackRock), Vanguard, SPDR (State Street), Invesco, WisdomTree, and more. Coverage includes broad market index ETFs, sector ETFs, regional ETFs, bond ETFs, and thematic ETFs. Availability varies by region.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e040eb02d565e290cff84\",\"question\":\"Can I use CopyTrader for ETF investing?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. You can copy investors who focus on ETF-based portfolios. Their allocations become yours proportionally. You can review their track record, risk score, portfolio composition, and historical returns before deciding to copy. Stop copying at any time with no extra fee.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Investing \",\"complianceTags\":[]},{\"id\":\"6a5e0543b02d565e290cff86\",\"questions\":[{\"id\":\"6a5e054fb02d565e290cff87\",\"question\":\"How do I start investing in ETFs?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Sign up for an eToro account, verify your identity, and deposit funds. Then browse ETFs by sector, region, provider, or theme. Select an ETF, choose your investment amount (from $10), and open a non-leveraged BUY position. You now own the underlying shares.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]},{\"id\":\"6a5e056cb02d565e290cff88\",\"question\":\"Is there a demo account for ETF investing?\",\"answer\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Yes. All eToro accounts come with a free demo mode with $100,000 in virtual funds. You can invest in ETFs using real market data, test different portfolio strategies, and get comfortable with the platform — all without risking any real capital. Switch between demo and live at any time.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"complianceTags\":[]}],\"label\":\"Getting Started\",\"complianceTags\":[]}],\"blockType\":\"faq\",\"headline\":\"Questions? We've got you.\",\"complianceTags\":[]},{\"id\":\"6a5e0685b02d565e290cff89\",\"type\":\"closingCta\",\"emphasizeFinalPunctuation\":null,\"showBackgroundImage\":null,\"priorityImageLoading\":null,\"blockName\":null,\"stats\":[{\"id\":\"6a5e070ab02d565e290cff8a\",\"label\":\"Licensed \u0026 Regulated\"},{\"id\":\"6a5e0724b02d565e290cff8b\",\"label\":\"NASDAQ: ETOR\"},{\"id\":\"6a5e072eb02d565e290cff8c\",\"label\":\"Since 2007\"},{\"id\":\"6a5e0736b02d565e290cff8d\",\"label\":\"Real ETF Ownership\"},{\"id\":\"6a5e0740b02d565e290cff8e\",\"label\":\"40M+ users\"}],\"blockType\":\"closingCta\",\"eyebrow\":null,\"headline\":\"300+ ETFs. Your move.\",\"supporting\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"eToro. Where smart investors build portfolios.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"primaryCta\":{\"show\":null,\"label\":\"Start Investing\",\"href\":\"https://www.etoro.com/accounts/sign