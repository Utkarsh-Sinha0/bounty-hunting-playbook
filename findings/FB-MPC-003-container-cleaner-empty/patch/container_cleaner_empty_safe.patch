diff --git a/include/utils/string_utils.h b/include/utils/string_utils.h
index 7eb5ebc..b9bf608 100644
--- a/include/utils/string_utils.h
+++ b/include/utils/string_utils.h
@@ -15,7 +15,18 @@ class container_cleaner
 {
 public:
     [[nodiscard]] explicit container_cleaner(T& secret) : _secret(secret) {}
-    ~container_cleaner() {OPENSSL_cleanse(&_secret[0], _secret.size());}
+
+    // Empty containers: operator[] / &_secret[0] is undefined behaviour.
+    // data() is well-defined for empty std::vector/std::string (may be nullptr);
+    // OPENSSL_cleanse must not be called with a null pointer and non-zero len,
+    // and there is nothing to wipe when empty.
+    ~container_cleaner()
+    {
+        if (!_secret.empty())
+        {
+            OPENSSL_cleanse(_secret.data(), _secret.size());
+        }
+    }
 
     container_cleaner(const container_cleaner&) = delete;
     container_cleaner& operator=(const container_cleaner&) = delete;
