diff --git a/include/crypto/common/byte_io.h b/include/crypto/common/byte_io.h
new file mode 100644
index 0000000..8d72bc6
--- /dev/null
+++ b/include/crypto/common/byte_io.h
@@ -0,0 +1,33 @@
+#pragma once
+
+/*
+ * Alignment-safe host-endian u32 load/store for length-prefixed wire formats.
+ *
+ * The legacy serializers used `*(uint32_t*)p` after variable-length BN payloads,
+ * which is undefined behaviour on targets that require natural alignment and
+ * can SIGBUS on aarch64. memcpy avoids the unaligned access while preserving
+ * the existing host-endian on-wire encoding.
+ */
+
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline void store_u32(uint8_t *p, uint32_t v)
+{
+    memcpy(p, &v, sizeof(v));
+}
+
+static inline uint32_t load_u32(const uint8_t *p)
+{
+    uint32_t v;
+    memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+#ifdef __cplusplus
+}
+#endif
